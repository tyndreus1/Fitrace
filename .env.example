# --- Yapay zekâ (Netlify fonksiyonları) ---
# Netlify panelinde: Site settings → Environment variables
# Bu anahtar olmadan da site çalışır; kalori tahmini yerel besin tablosuna düşer,
# koç sohbeti ise kapalı kalır.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (isteğe bağlı) ---
# Tanımlamazsan tüm kayıtlar tarayıcıda (localStorage) tutulur.
# Tanımlarsan kayıtlar buluta yazılır ve cihazlar arasında senkron olur.
VITE_SUPABASE_URL=https://PROJENIZ.supabase.co
VITE_SUPABASE_ANON_KEY=anon-anahtariniz
